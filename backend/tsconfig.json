{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@sela/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "server.ts"],
  "exclude": ["node_modules"]
}
